# =============================================================================
# SAMAQU — template env untuk Vercel
# Salin jadi `.env.local`, lalu isi nilainya.
# JANGAN COMMIT file berisi nilai asli.
# =============================================================================

# --- Supabase (WAJIB — dibaca di module scope) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudinary: produk / video ---
NEXT_PUBLIC_CLOUDINARY_CLOUD=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Cloudinary: live chat (akun terpisah) ---
CHAT_CLOUDINARY_CLOUD=
CHAT_CLOUDINARY_API_KEY=
CHAT_CLOUDINARY_API_SECRET=

# --- Cloudinary: review / reseller (akun terpisah) ---
REVIEW_CLOUDINARY_CLOUD=
REVIEW_CLOUDINARY_API_KEY=
REVIEW_CLOUDINARY_API_SECRET=

# --- J&T Express ---
JNT_ENV=production
JNT_ORDER_USERNAME=
JNT_ORDER_API_KEY=
JNT_ORDER_KEY=
JNT_TARIFF_KEY=
JNT_TARIFF_CUS_NAME=
JNT_TRACK_USERNAME=
JNT_TRACK_PASSWORD=
JNT_COMPANY_ID=

# --- Secret internal (openssl rand -hex 32) ---
OTP_SECRET=
ORDER_TOKEN_SECRET=
VISIT_HASH_SECRET=
RATE_LIMIT_SECRET=
CRON_SECRET=
REVALIDATE_SECRET=

# --- App ---
NEXT_PUBLIC_SITE_URL=https://www.samaqu.id

# --- Opsional (produksi baca DB) ---
NEXT_PUBLIC_META_PIXEL_ID=
MIMO_ADMIN_MODEL=
AI_ADMIN_REQUEST_BUDGET_MS=

# --- Mayar (kalau tidak memakai tabel mayar_settings) ---
MAYAR_API_KEY=
MAYAR_WEBHOOK_TOKEN=
MAYAR_ENV=production
MAYAR_ENABLED=
